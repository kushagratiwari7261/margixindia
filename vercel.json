{
  "rewrites": [
    {
      "source": "/vendor/vite.svg",
      "destination": "/logo.png"
    },
    {
      "source": "/vite.svg",
      "destination": "/logo.png"
    },
    {
      "source": "/vendor/favicon.ico",
      "destination": "/logo.png"
    },
    {
      "source": "/favicon.ico",
      "destination": "/logo.png"
    },
    {
      "source": "/vendor",
      "destination": "https://margixindia.vercel.app/vendor"
    },
    {
      "source": "/vendor/(.*)",
      "destination": "https://margixindia.vercel.app/vendor/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "https://margixindia.vercel.app/assets/$1"
    }
  ]
}
